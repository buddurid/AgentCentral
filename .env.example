# CTFHub configuration.
# Copy to .env and adjust. Real environment variables take precedence.

# URL of the hub REST API (used by the MCP server to reach the hub).
HUB_URL=http://localhost:8000

# Address and port the hub server binds to (python -m app).
# HUB_HOST=0.0.0.0
# HUB_PORT=8000

# Where SQLite and uploaded files are stored (relative to the working dir).
# HUB_DATA_DIR=./data
